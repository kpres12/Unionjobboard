{
  "name": "union-jobboard",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "seed": "npm run seed --prefix server",
    "sync-jobs": "npm run sync-jobs --prefix server",
    "sync-signals": "npm run sync-signals --prefix server",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev:python": "cd python-service && source venv/bin/activate && uvicorn main:app --reload --port 8001",
    "dev": "npm run seed && concurrently \"npm run dev:server\" \"npm run dev:python\" \"npm run dev:client\"",
    "stripe:setup": "bash scripts/setup-stripe-test.sh",
    "stripe:webhook": "stripe listen --forward-to localhost:3001/api/billing/webhook --print-secret",
    "stripe:login": "stripe login",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
